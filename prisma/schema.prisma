generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Workout {
  id							String     @id @default(cuid())
  name						String
  createdAt				DateTime   @default(now())
	durationSeconds Int?
  exercises				Exercise[]
}

model GlobalExercise {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
	// Stored as JSON array of strings
	muscleGroups   Json?

  exercises      Exercise[]
}

model Exercise {
  id					String    @id @default(cuid())
  workoutId 	String
  workout   	Workout   @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  globalExerciseId String
  globalExercise   GlobalExercise @relation(fields: [globalExerciseId], references: [id])
  sets				Set[]
	difficulty	Float?
	notes				String?
}

model Set {
  id         String    @id @default(cuid())
  weight     Float
  reps       Int
  exerciseId String
  completed  Boolean   @default(false)
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
}
