{
	"name": "horus",
	"type": "module",
	"version": "0.1.0",
	"private": true,
	"packageManager": "bun@1.4.4",
	"trustedDependencies": [],
	"scripts": {
		"dev": "next dev --hostname 127.0.0.1 --port 8000",
		"db:migrate": "tsx tools/db/migrate.ts",
		"build": "next build",
		"start": "next start --hostname 127.0.0.1 --port 8000",
		"test": "playwright test",
		"test:production": "HORUS_TEST_SERVER=production playwright test",
		"verify": "bun run lint:check && bun run format:check && bun run typecheck && bun run fallow:check && bun run test",
		"postinstall": "test \"$PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD\" = 1 || playwright install chromium",
		"format": "bun fmt",
		"format:check": "bun fmt --check",
		"lint": "effect-tsgo --tsrs-lint oxlint . --fix && tsx --test 'tools/oxlint/**/*.test.ts'",
		"lint:check": "effect-tsgo --tsrs-lint oxlint . && tsx --test 'tools/oxlint/**/*.test.ts'",
		"fallow:check-dead-code": "fallow dead-code --fail-on-issues --quiet",
		"fallow:check-dupes": "fallow dupes --ci",
		"fallow:check": "bun run fallow:check-dead-code && bun run fallow:check-dupes",
		"typecheck": "bun check"
	},
	"dependencies": {
		"@base-ui/react": "1.9.0",
		"@daveyplate/better-auth-ui": "^3.4.0",
		"@effect/sql-pg": "4.0.2",
		"@hookform/resolvers": "^5.2.2",
		"@orpc/client": "^1.14.8",
		"@orpc/server": "^1.14.8",
		"@orpc/tanstack-query": "^1.14.8",
		"@radix-ui/react-checkbox": "^1.3.3",
		"@radix-ui/react-collapsible": "^1.1.12",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-label": "^2.1.8",
		"@radix-ui/react-slider": "^1.3.6",
		"@radix-ui/react-slot": "^1.2.4",
		"@t3-oss/env-nextjs": "^0.13.11",
		"@tabler/icons-react": "^3.46.0",
		"@tanstack/react-query": "^5.96.1",
		"@upstash/redis": "^1.36.4",
		"better-auth": "1.7.23",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.4.0",
		"dayjs": "^1.11.19",
		"effect": "4.0.2",
		"lucide-react": "^0.553.0",
		"next": "16.4.6",
		"next-themes": "^0.4.6",
		"pg": "^8.16.3",
		"radix-ui": "^1.4.3",
		"react": "19.3.0",
		"react-calendar-heatmap": "^1.10.0",
		"react-dom": "19.3.0",
		"react-hook-form": "^7.71.0",
		"recharts": "3.8.0",
		"resend": "^6.14.0",
		"server-only": "^0.0.1",
		"sonner": "^2.0.7",
		"vaul": "^1.1.2",
		"zod": "^4.6.6",
		"zustand": "^5.0.12"
	},
	"devDependencies": {
		"@effect/tsgo": "0.73.2",
		"@neondatabase/serverless": "^1.1.0",
		"@oxlint/plugins": "1.94.0",
		"@playwright/test": "^1.62.1",
		"@shadcn/lint": "^0.2.1",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^24.10.1",
		"@types/pg": "^8.15.5",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"babel-plugin-react-compiler": "^1.0.0",
		"dotenv": "^17.4.2",
		"fallow": "3.34.0",
		"oxlint": "1.94.0",
		"tailwindcss": "^4",
		"tsx": "^4.23.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "7.0.2"
	}
}
