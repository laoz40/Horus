{
	"compilerOptions": {
		"target": "ES2016",
		"module": "ESNext",
		"rootDir": "./src",
		"outDir": "./dist",
		"strict": true,
		"sourceMap": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"moduleResolution": "node",
		"baseUrl": "./"
	},
	"include": ["src/**/*", "dist"]
}
